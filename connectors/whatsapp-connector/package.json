{
  "name": "whatsapp-connector",
  "version": "0.2.0",
  "private": true,
  "description": "Private 24/7 WhatsApp MCP connector for ChatGPT and Codex",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "pair": "node dist/src/admin.js pair",
    "status": "node dist/src/admin.js status",
    "purge": "node dist/src/admin.js purge",
    "export": "node dist/src/admin.js export",
    "revoke": "node dist/src/admin.js revoke",
    "backup": "node dist/src/admin.js backup",
    "restore": "node dist/src/admin.js restore",
    "generate-secret": "node scripts/generate-secret.mjs",
    "configure-plugin": "node scripts/configure-plugin.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "better-sqlite3": "12.11.1",
    "express": "5.2.1",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "qrcode-terminal": "0.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.10.9",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
