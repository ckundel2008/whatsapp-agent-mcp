NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://whatsapp.example.com
WHATSAPP_DOMAIN=whatsapp.example.com
DATA_DIR=/data
AUTH_DISABLED=false
OAUTH_ISSUER=https://example.eu.auth0.com/
OAUTH_AUDIENCE=https://whatsapp.example.com/mcp
OAUTH_OWNER_SUBJECTS=auth0|replace-with-owner-subject
AUTH_STATE_KEY_FILE=/run/secrets/auth_state_key
MAX_MEDIA_BYTES=20971520
SEND_TOKEN_TTL_SECONDS=600
SEND_RATE_LIMIT_COUNT=5
SEND_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info
ALERT_WEBHOOK_URL=
